<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" tools:ignore="ForegroundServicePermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyToolsProject"
        tools:targetApi="31">

        <!-- Tela de Bloqueio (PIN/Biometria) — agora é a entrada do app -->
        <activity
            android:name=".LockActivity"
            android:exported="true"
            android:theme="@style/Theme.MyToolsProject">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela de Introdução (Splash) -->
        <activity
            android:name=".SplashActivity"
            android:exported="false"
            android:theme="@style/Theme.MyToolsProject"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tela Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Tela da Ferramenta 1 (Senhas Wi-Fi) -->
        <activity
            android:name=".WifiPasswordsActivity"
            android:exported="false" />

        <!-- Tela da Ferramenta 2 (Dispositivos na Rede) -->
        <activity
            android:name=".NetworkScannerActivity"
            android:exported="false" />

        <!-- Tela da Ferramenta 4 (Redes Wi-Fi Próximas + Auditoria WPS passiva) -->
        <activity
            android:name=".WifiScannerActivity"
            android:exported="false" />

        <!-- Tela da Ferramenta 5 (NFC: Ler/Escrever NDEF + Dump/Clonagem MIFARE Classic) -->
        <activity
            android:name=".NfcToolsActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <!-- Tela de Configurações -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Ferramenta: Calculadora de Sub-rede/CIDR -->
        <activity
            android:name=".SubnetCalculatorActivity"
            android:exported="false" />

        <!-- Ferramenta: Scanner de Porta Customizável -->
        <activity
            android:name=".PortScannerActivity"
            android:exported="false" />

        <!-- Ferramenta: Teste de Velocidade -->
        <activity
            android:name=".SpeedTestActivity"
            android:exported="false" />

        <!-- Tela do Banco de Dados JSON -->
        <activity
            android:name=".ManageDevicesActivity"
            android:exported="false" />

        <!-- Serviço de Monitoramento em Segundo Plano (Dispositivos na Rede) -->
        <service
            android:name=".NetworkMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Serviço de Monitoramento em Segundo Plano (Radar Wi-Fi) -->
        <service
            android:name=".WifiScanBackgroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- FileProvider: necessário para exportar/compartilhar o banco de dados JSON -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>