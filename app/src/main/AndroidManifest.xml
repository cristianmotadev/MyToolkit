<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" tools:ignore="ForegroundServicePermission" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyToolsProject"
        tools:targetApi="31">

        <!-- Tela de Introdução (Splash) -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.MyToolsProject"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela Principal -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Tela da Ferramenta 1 (Senhas Wi-Fi) -->
        <activity
            android:name=".WifiPasswordsActivity"
            android:exported="false" />

        <!-- Tela da Ferramenta 2 (Dispositivos na Rede) -->
        <activity
            android:name=".NetworkScannerActivity"
            android:exported="false" />

        <!-- Tela de Configururações -->
        <activity
            android:name=".SettingsActivity"
            android:exported="false" />

        <!-- Tela do Banco de Dados JSON -->
        <activity
            android:name=".ManageDevicesActivity"
            android:exported="false" />

        <!-- Serviço de Monitoramento em Segundo Plano -->
        <service
            android:name=".NetworkMonitorService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

    </application>

</manifest>