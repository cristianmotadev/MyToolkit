<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="🔑 Gerador de Senhas"
        android:textColor="#2196F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtSenhaGerada"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="center"
                android:fontFamily="monospace"
                android:padding="8dp" />

            <TextView
                android:id="@+id/txtForcaSenha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text=""
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <Button
        android:id="@+id/btnCopiarSenhaGerada"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:backgroundTint="#2196F3"
        android:text="📋 Copiar Senha"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txtTamanhoSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tamanho: 16 caracteres"
        android:textColor="#CCCCCC"
        android:textSize="14sp" />

    <SeekBar
        android:id="@+id/seekTamanhoSenha"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp" />

    <CheckBox
        android:id="@+id/checkMaiusculas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Letras maiúsculas (A-Z)"
        android:textColor="#FFFFFF" />

    <CheckBox
        android:id="@+id/checkMinusculas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Letras minúsculas (a-z)"
        android:textColor="#FFFFFF" />

    <CheckBox
        android:id="@+id/checkNumeros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checked="true"
        android:text="Números (0-9)"
        android:textColor="#FFFFFF" />

    <CheckBox
        android:id="@+id/checkSimbolos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:checked="true"
        android:text="Símbolos (!@#$%...)"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnGerarSenha"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:backgroundTint="#2196F3"
        android:text="🔄 Gerar Nova Senha"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />

</LinearLayout>
</ScrollView>
