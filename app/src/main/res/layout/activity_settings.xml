<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⚙️ Configurações"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:paddingBottom="16dp"/>

    <!-- ================= STATUS DO SISTEMA ================= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STATUS DO SISTEMA"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/btnVerificarRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🔑 Verificar Acesso Root"
                android:backgroundTint="#1E88E5"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>

            <TextView
                android:id="@+id/txtStatusRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Toque no botão acima para verificar."
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="#333333"/>

            <TextView
                android:id="@+id/txtStatusNotificacao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Verificando permissão de notificações..."
                android:textColor="#AAAAAA"
                android:textSize="13sp"/>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="#333333"/>

            <TextView
                android:id="@+id/txtVersaoApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Tools Project"
                android:textColor="#777777"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= MONITORAMENTO EM SEGUNDO PLANO ================= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MONITORAMENTO EM SEGUNDO PLANO (mDNS)"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchMdns"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Escaneamento contínuo (segundo plano)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Deixa a escuta ativa para capturar o nome de aparelhos que saem do modo de economia de energia."
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Intervalo de escaneamento (segundos):"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/editIntervalo"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="30"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2196F3"/>

                <Button
                    android:id="@+id/btnSalvarIntervalo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="OK"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="10dp"
                android:background="#333333"/>

            <Switch
                android:id="@+id/switchNotificarNovos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Notificar ao encontrar dispositivo novo"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= PERMISSÕES ================= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PERMISSÕES"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchLocationPermission"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Permissão de localização (Wi-Fi)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Necessário para o Android ler o nome da rede Wi-Fi atual e escanear redes próximas."
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= INTERVALOS PADRÃO DOS SCANNERS ================= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="INTERVALOS PADRÃO DOS SCANNERS"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Define o valor inicial do modo automático nas telas de Redes Wi-Fi Próximas e Dispositivos na Rede."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:paddingBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="📡 Redes Wi-Fi Próximas (s):"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/editIntervaloWifiPadrao"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="30"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2196F3"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🌐 Dispositivos na Rede (s):"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>

                <EditText
                    android:id="@+id/editIntervaloNetworkPadrao"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="90"
                    android:textColor="#FFFFFF"
                    android:backgroundTint="#2196F3"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnSalvarIntervalosPadrao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Salvar Intervalos Padrão"
                android:backgroundTint="#2196F3"
                android:textColor="#FFFFFF"
                android:padding="10dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= SEGURANÇA DO APP ================= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEGURANÇA DO APP"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Switch
                android:id="@+id/switchBloqueioApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exigir PIN/Biometria ao abrir o app"
                android:textColor="#FFFFFF"
                android:textSize="15sp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Protege as senhas Wi-Fi e os dados de rede salvos contra acesso por outras pessoas com o celular em mãos."
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnAlterarPin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="🔑 Alterar PIN"
                android:backgroundTint="#1E88E5"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- ================= BANCO DE DADOS ================= -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="BANCO DE DADOS (JSON)"
        android:textColor="#2196F3"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <Button
                android:id="@+id/btnEditJson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👥 Gerenciar Dispositivos Salvos"
                android:backgroundTint="#1E88E5"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnLimparCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🗑️ Limpar Banco de Dados"
                android:backgroundTint="#D32F2F"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnExportarCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="📤 Exportar Banco de Dados"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>

            <Button
                android:id="@+id/btnImportarCache"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="📥 Importar Banco de Dados"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:padding="12dp"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
</ScrollView>
