<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:text="#️⃣ Calculadora de Hash"
        android:textColor="#2196F3"
        android:textSize="22sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/editHashTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:background="#1E1E1E"
        android:hint="Digite um texto para calcular o hash"
        android:padding="12dp"
        android:minLines="2"
        android:textColor="#FFFFFF"
        android:textColorHint="#777777" />

    <Button
        android:id="@+id/btnCalcularHashTexto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#2196F3"
        android:text="Calcular Hash do Texto"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnEscolherArquivoHash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:backgroundTint="#1E88E5"
        android:text="📄 Ou Escolher um Arquivo"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/txtArquivoSelecionadoHash"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text=""
        android:textColor="#AAAAAA"
        android:textSize="12sp" />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E1E1E"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MD5 (toque para copiar)"
                android:textColor="#777777"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtHashMd5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHA-1 (toque para copiar)"
                android:textColor="#777777"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtHashSha1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHA-256 (toque para copiar)"
                android:textColor="#777777"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtHashSha256"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SHA-512 (toque para copiar)"
                android:textColor="#777777"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/txtHashSha512"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="—"
                android:textColor="#FFFFFF"
                android:textIsSelectable="true"
                android:textSize="13sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
</ScrollView>
